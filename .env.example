# ------------------------------------------------------------
# docker compose 变量模板（2026-09-28 数据库容器化产物）
#
# 用法：在项目根目录执行
#     Copy-Item .env.example .env
# 然后把下面四个占位值改成真实值。.env 含口令，已被 .gitignore 与
# .dockerignore 双重排除——不入库、不进应用镜像构建上下文（规则 1.4）。
#
# 一致性要求：MYSQL_DATABASE / MYSQL_USER / MYSQL_PASSWORD 必须与
# day15_orm/db_config_local_container.py 的 DB_NAME / DB_USER / DB_PASSWORD 一致，
# 否则应用连不上容器数据库。
#
# 注意：官方 mysql 镜像只在【空卷首启】时用这些变量初始化库和账号；
# 卷 mysql_data 已存在后再改这里不会生效（需删卷重建，属破坏性操作，单独确认）。
# ------------------------------------------------------------

# 容器 MySQL 的 root 口令（仅健康检查与首次初始化用，应用不走 root）
MYSQL_ROOT_PASSWORD=change_me_root

# 库名。须与宿主机现有库同名，dump 导入后才对得上
MYSQL_DATABASE=your_database_name

# 应用连接账号。官方镜像会自动创建该账号并授予 MYSQL_DATABASE 库的全部权限，
# 因此不会再出现宿主机时代的 ERROR 1130 授权问题
MYSQL_USER=your_mysql_user

# 应用连接口令
MYSQL_PASSWORD=change_me_app
